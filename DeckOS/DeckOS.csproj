<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dois alvos:
      net8.0-windows10.0.17763.0: o app de bandeja do Windows, com tudo (WinForms, NAudio,
                                  WinRT de midia, Velopack). Define WINDOWS.
      net8.0:                     macOS e Linux. So o servidor web, em console/segundo plano;
                                  o que e do Windows fica de fora (ver Platform/).
  -->
  <PropertyGroup>
    <!-- Fora do Windows o restore nem tenta o TFM do Windows (NETSDK1100 no macOS/Linux). -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0-windows10.0.17763.0;net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.17763.0'">
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>deckos.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <OutputType>Exe</OutputType>
    <!-- O codigo de P/Invoke do Windows que sobra compilado so roda atras de OperatingSystem.IsWindows(). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LocalStorage" Version="2.1.0" />
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NLog" Version="6.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.17763.0'">
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- System.Drawing so existe no Windows: fora dele, redimensionar capas e icones usa o Skia
         (Lib/ImageOps.cs). O pacote base traz o nativo do macOS; o do Linux vem sem dependencias
         (nao exige fontconfig instalado). -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- DPAPI do SecretFile: compila aqui e so e chamado no Windows (macOS/Linux gravam com permissao 600). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Arquivos que so fazem sentido no Windows (bandeja, NAudio, WinRT, WMI, Velopack). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="frmPrincipal.cs;frmPrincipal.Designer.cs;frmPairing.cs;AppIcon.cs" />
    <EmbeddedResource Remove="frmPrincipal.resx" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <Compile Remove="Lib\AppUpdater.cs;Lib\FirewallSetup.cs;Lib\MonitorBrightness.cs" />
    <Compile Remove="Audio\**" />
    <Compile Remove="Mixer\MixerMaster.cs;Mixer\MixerChannel.cs;Mixer\MixerEntity.cs" />
    <Compile Remove="Services\MixerService.cs;Services\AudioControlService.cs;Services\MediaControlService.cs" />
    <Compile Remove="Actions\Providers\WindowsProvider.cs" />
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bandeja e janelas carregam o tamanho exato daqui (ver AppIcon.cs). -->
    <EmbeddedResource Include="deckos.ico" LogicalName="DeckOS.deckos.ico" />
    <!-- Um arquivo por idioma, os mesmos do app: o PC acha os idiomas por eles. -->
    <EmbeddedResource Include="..\app\assets\i18n\*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- TuyaCrypto e interno de proposito (ninguem fora do plugin deve montar assinatura),
         mas precisa ser testavel: e a unica peca do plugin que falha em silencio. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DeckOS.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.17763.0'">
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copia Static\ para a saida (antes era um xcopy, so no Windows). -->
  <Target Name="CopyStatic" AfterTargets="Build">
    <ItemGroup>
      <StaticFiles Include="$(ProjectDir)Static\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(StaticFiles)" DestinationFiles="@(StaticFiles->'$(OutDir)Static\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
